{{!
    @template paygw_chargily/pay

    Choose the card to pay with; each button goes straight to Chargily's checkout page.

    Example context (json):
    {
        "description": "Enrolment in Introduction to Physics", "cost": "DZD 2,500.00",
        "action": "#", "sesskey": "x", "hidden": [{"name": "itemid", "value": "3"}],
        "hasmethods": true,
        "methods": [{"value": "edahabia", "label": "EDAHABIA", "help": "Algerie Poste card"},
                    {"value": "cib", "label": "CIB", "help": "Bank card"}]
    }
}}
<div class="paygw-chargily">
    <p class="paygw-chargily-what">{{description}}</p>
    <p class="paygw-chargily-cost">{{cost}}</p>
    {{#hasmethods}}
    <form method="post" action="{{action}}" class="paygw-chargily-methods">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#hidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hidden}}
        {{#methods}}
        <button type="submit" name="method" value="{{value}}" class="paygw-chargily-method">
            <span class="paygw-chargily-method-label">{{label}}</span>
            <span class="paygw-chargily-method-help">{{help}}</span>
        </button>
        {{/methods}}
    </form>
    <p class="paygw-chargily-note">{{#str}}redirectnote, paygw_chargily{{/str}}</p>
    {{/hasmethods}}
    {{^hasmethods}}
    <p class="alert alert-warning">{{#str}}error:nomethod, paygw_chargily{{/str}}</p>
    {{/hasmethods}}
</div>
